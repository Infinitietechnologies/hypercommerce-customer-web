# Backend Laravel panel base URL. API base is derived from this (/api is appended).
NEXT_PUBLIC_ADMIN_PANEL_URL=https://your-panel-domain.com

# Public URL of this storefront (used for SEO, sitemap, canonical tags).
NEXT_PUBLIC_SITE_URL=https://your-storefront-domain.com

# App version string.
NEXT_PUBLIC_APP_VERSION=1.0.0

# Server-side rendering flag.
NEXT_PUBLIC_SSR=true
