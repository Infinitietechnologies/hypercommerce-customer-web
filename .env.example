# Backend Laravel panel base URL. API base is derived from this (/api is appended).
NEXT_PUBLIC_ADMIN_PANEL_URL=https://your-panel-domain.com

# Public URL of this storefront (used for SEO, sitemap, canonical tags).
NEXT_PUBLIC_SITE_URL=https://your-storefront-domain.com

# GA4 measurement ID. Defaults to the production property when omitted.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-WHEQTBMDCR

# Microsoft Clarity project ID. Defaults to the production project when omitted.
NEXT_PUBLIC_MICROSOFT_CLARITY_ID=y7wc5695pb

# Extra hosts the image optimizer may fetch from, comma separated. The panel
# host above is always allowed. Leave empty unless images come from a CDN.
NEXT_PUBLIC_IMAGE_HOSTS=

# App version string. Overridden at build time by next.config.ts from package.json.
NEXT_PUBLIC_APP_VERSION=3.1.0

# Server-side rendering flag.
NEXT_PUBLIC_SSR=true
